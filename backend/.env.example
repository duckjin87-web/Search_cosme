# 복사해서 .env 로 쓰고 값을 채운다. .env 는 레포에 올리지 않는다.
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=searchcosme
MINIO_ROOT_PASSWORD=change-me-too

# Tier 1 네이버 쇼핑 검색 API (https://developers.naver.com 애플리케이션 등록)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Tier 2 화해: 자동 접근을 차단하고 있어 기본 꺼짐. 제휴·허가 후에만 1 로.
SC_ENABLE_HWAHAE=0
# Tier 4 브랜드 자사몰 (등록한 URL만, robots.txt 준수)
SC_ENABLE_BRAND_PAGES=1

# OCR: tesseract(사내 구동, 기본) | clova | google
SC_OCR_ENGINE=tesseract
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
GOOGLE_VISION_API_KEY=

# 면 분류: heuristic(기본, 외부 전송 없음) | claude (ANTHROPIC_API_KEY 필요)
SC_FACE_CLASSIFIER=heuristic
ANTHROPIC_API_KEY=
